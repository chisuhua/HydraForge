{
  "$schema": "https://schemas.hydraforge.io/pdk-manifest-v1.json",
  "id": "infra.temporal",
  "name": "Temporal Agent",
  "version": "0.1.0",
  "abi_version": 2,
  "min_host_version": "0.3.0",
  "max_host_version": "1.0.0",
  "interface_versions": ["IAgentV1"],
  "implementation_forms": ["cpp"],
  "entry_tool": "temporal/start_workflow",
  "provided_tools": [
    "temporal/start_workflow",
    "temporal/start_async",
    "temporal/poll",
    "temporal/signal",
    "temporal/query"
  ],
  "capabilities": ["temporal", "workflow_orchestration", "grpc", "durable_execution"],
  "requires_isolation": false,
  "resources": {
    "timeout_ms": 30000,
    "max_concurrent": 8
  },
  "publisher": "hydraforge-team",
  "trust_level": "high"
}
