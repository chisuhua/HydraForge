# Dockerfile.tsan
# 文件头注释
# 功能描述：TSan 容器化验证 (解决 ASLR 已知遗留, plan §3.3 H1)。
#          1000x 并发测试在容器内 TSan 干净, 排除宿主 ASLR 假阳性 data race。
#          基于 ubuntu:22.04 + gcc-13 + cmake + Ninja, ASLR=0 + TSAN_OPTIONS 严格化。
# 设计依据：openspec/changes/2026-06-30-domain-worker-pool + ADR-0020 §2.2.1 P2
#          + plan §3.3 H1 (TSan ASLR 已知遗留)
# 作者：AgenticDSL Phase 1 Sprint 3
# 最后修改日期：2026-06-19

# === Stage 1: 编译 (build) ===
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TSAN_OPTIONS="halt_on_error=1:abort_on_error=1:exitcode=66:second_deadlock_stack=1:history_size=7"

# 安装编译工具链 (gcc-13 for C++20 std::jthread + std::stop_token 完整支持)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        ca-certificates \
        g++-13 \
        libstdc++-13-dev \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-13 100 \
    && rm -rf /var/lib/apt/lists/*

# 验证 gcc-13 默认
RUN gcc --version | head -1 && g++ --version | head -1

# 禁用 ASLR (容器内, 排除宿主 ASLR 假阳性)
# 注: Docker 默认 ASLR=0 (容器独立 PID namespace), 此行仅为显式声明
RUN echo 0 > /proc/sys/kernel/randomize_va_space 2>/dev/null || true

# 工作目录
WORKDIR /hydraforge

# 复制源码 (利用 Docker 缓存: 先复制 CMakeLists, 依赖文件未变则不重 build)
COPY CMakeLists.txt CMakePresets.json ./
COPY external ./external
COPY include ./include
COPY src ./src
COPY tests ./tests
COPY lib ./lib
COPY llm_config.json ./

# 配置 + 编译 (TSan 标志)
RUN mkdir -p build-tsan && cd build-tsan && \
    cmake .. -G Ninja \
        -DCMAKE_BUILD_TYPE=Debug \
        -DCMAKE_CXX_COMPILER=g++-13 \
        -DCMAKE_CXX_FLAGS="-fsanitize=thread -g -O1 -fno-omit-frame-pointer" \
        -DCMAKE_EXE_LINKER_FLAGS="-fsanitize=thread" \
        -DCMAKE_SHARED_LINKER_FLAGS="-fsanitize=thread" \
        -DAGENTICDSL_BUILD_TESTS=ON \
    && ninja -j$(nproc) test_domain_worker_pool

# === Stage 2: 运行 (runtime) ===
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV TSAN_OPTIONS="halt_on_error=1:abort_on_error=1:exitcode=66:second_deadlock_stack=1:history_size=7"

# 仅安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 禁用 ASLR
RUN echo 0 > /proc/sys/kernel/randomize_va_space 2>/dev/null || true

# 从 builder 复制编译产物
WORKDIR /hydraforge
COPY --from=builder /hydraforge/build-tsan/tests/test_domain_worker_pool /hydraforge/test_domain_worker_pool

# 验证 ctest 退出码 0: 7/7 test case TSan 干净 (含 1000x 并发)
# 注: 此 Dockerfile 仅验证 DomainWorkerPool, 全量 ctest 由 build/ 常规 ctest 验证
#      (避免 TSan 全量编译时间过长, 5+ 分钟)
CMD ["/hydraforge/test_domain_worker_pool", "--reporter", "compact"]

# === 使用示例 ===
# docker build -f Dockerfile.tsan -t hydraforge-tsan .
# docker run --rm hydraforge-tsan
# 预期输出: "All tests passed (94 assertions in 7 test cases)"
#
# === CI 集成 (.github/workflows/ci.yml) ===
# - name: TSan validation (Dockerfile.tsan)
#   run: |
#     docker build -f Dockerfile.tsan -t hydraforge-tsan .
#     docker run --rm hydraforge-tsan
